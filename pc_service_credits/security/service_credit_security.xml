<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_service_credit_user" model="res.groups">
        <field name="name">Service Credits / User</field>
    </record>

    <record id="group_service_credit_manager" model="res.groups">
        <field name="name">Service Credits / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_service_credit_user'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_service_credit_manager'))]"/>
    </record>

    <!-- Reglas multiempresa -->
    <record id="rule_wallet_company" model="ir.rule">
        <field name="name">Service credit wallet: multi-company</field>
        <field name="model_id" ref="model_service_credit_wallet"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_move_company" model="ir.rule">
        <field name="name">Service credit move: multi-company</field>
        <field name="model_id" ref="model_service_credit_move"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_rate_company" model="ir.rule">
        <field name="name">Service credit rate: multi-company</field>
        <field name="model_id" ref="model_service_credit_rate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_multiplier_company" model="ir.rule">
        <field name="name">Service credit multiplier: multi-company</field>
        <field name="model_id" ref="model_service_credit_multiplier"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>
</odoo>
